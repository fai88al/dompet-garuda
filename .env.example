# Copy this file to .env and fill in real values. Never commit .env.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/dompet
SPRING_DATASOURCE_USERNAME=dompet
SPRING_DATASOURCE_PASSWORD=

# Used by docker-compose.yml for the postgres container
POSTGRES_PASSWORD=

# JWT signing secret for admin session tokens (HMAC-SHA256, 32-byte key).
# Generate: openssl rand -hex 32
# Protects all /admin/** endpoints. See CLAUDE.md §4.
ADMIN_JWT_SECRET=

# Ed25519 private key seed for signing offline certificates (base64-encoded 32 bytes).
# Generate: openssl genpkey -algorithm ed25519 | openssl pkey -outform DER | tail -c 32 | base64
SERVER_SIGNING_KEY=

# Maximum amount (in whole Rupiah) that can be loaded into a device pouch per provisioning call.
POUCH_MAX_AMOUNT_IDR=500000

# Maximum amount (in whole Rupiah) allowed per online transfer (FR18/FR19, R10). Locked at 10,000,000.
TRANSFER_ONLINE_MAX_AMOUNT_IDR=10000000

# TTL in minutes for Bayar QR Online payment requests before they expire (FR20/FR22). Default 10.
QR_PAYMENT_REQUEST_TTL_MINUTES=10

# Comma-separated list of origins allowed to make browser requests to /admin/** and /device/**.
# In production set this to the backoffice UI origin (e.g. https://backoffice.dompetgaruda.com).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MQTT broker URL for the api profile's MqttAdminClient (FR25/FR26). Same broker as the worker's
# MQTT_BROKER_URL, ssl:// scheme, port 8883. See CLAUDE.md §15.
MQTT_BROKER_URL=ssl://mqtt.dompetgaruda.com:8883

# Credentials for the api profile's MqttAdminClient — a dedicated admin-role account on the
# Mosquitto Dynamic Security plugin, separate from the worker's dompet-worker account. Already
# provisioned on the VPS broker (CLAUDE.md §15) — this only wires the codebase to consume them.
MQTT_API_ADMIN_USERNAME=dompet-api-admin
MQTT_API_ADMIN_PASSWORD=
