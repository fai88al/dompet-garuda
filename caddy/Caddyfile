api.dompetgaruda.com {
	reverse_proxy api:8080 {
		header_up device_id {http.request.header.device_id}
	}
}

mqtt.dompetgaruda.com {
	respond "MQTT broker - connect on port 8883" 200
}

backoffice.dompetgaruda.com {
	reverse_proxy backoffice:3000
}

www.dompetgaruda.com {
	redir https://dompetgaruda.com{uri} permanent
}

dompetgaruda.com {
	reverse_proxy landing:3000
}